rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ໃບໂອນເງິນ — ລູກຄ້າອັບໂຫລດຕອນສັ່ງຊື້ (checkout) ໄດ້ໂດຍບໍ່ຕ້ອງ login
    match /receipts/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ຮູບສິນຄ້າ — ອ່ານໄດ້ທຸກຄົນ, ອັບໂຫລດ/ລຶບໄດ້ສະເພາະຜູ້ຈັດການທີ່ login ແລ້ວ
    match /products/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ຮູບ QR ຮັບເງິນ — ອ່ານໄດ້ທຸກຄົນ, ອັບໂຫລດໄດ້ສະເພາະຜູ້ຈັດການ
    match /payment/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ໂລໂກຮ້ານ — ອ່ານໄດ້ທຸກຄົນ, ອັບໂຫລດໄດ້ສະເພາະຜູ້ຈັດການ
    match /profile/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
