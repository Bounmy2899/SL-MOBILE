rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ໝວດສິນຄ້າ ແລະ ສິນຄ້າ — ລູກຄ້າອ່ານໄດ້ທຸກຄົນ, ແກ້ໄຂໄດ້ສະເພາະຄົນທີ່ login (ຜູ້ຈັດການ)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ອໍເດີ — ລູກຄ້າສ້າງອໍເດີໄດ້ (checkout) ໂດຍບໍ່ຕ້ອງ login
    // ແຕ່ອ່ານ/ແກ້ໄຂ/ລຶບ ໄດ້ສະເພາະຜູ້ຈັດການທີ່ login ແລ້ວເທົ່ານັ້ນ
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // ຄ່າໃຊ້ຈ່າຍ — ສະເພາະຜູ້ຈັດການ
    match /expenses/{expenseId} {
      allow read, write: if request.auth != null;
    }

    // ຂໍ້ມູນຮ້ານ / ບັນຊີຮັບເງິນ — ລູກຄ້າອ່ານໄດ້ (ໃຫ້ເຫັນຊື່ຮ້ານ, QR), ແກ້ໄຂໄດ້ສະເພາະຜູ້ຈັດການ
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
